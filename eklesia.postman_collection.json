    {
      "name": "Receitas",
      "item": [
        {
          "name": "POST /congregacoes/:congregacaoId/receitas (Dízimo)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tipo\": \"DIZIMO\",\n  \"valor\": \"150.00\",\n  \"formaPagamento\": \"ESPECIE\",\n  \"membroId\": {{membroId}}\n}"},
            "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/receitas"
          }
        },
        {
          "name": "POST /congregacoes/:congregacaoId/receitas (Oferta)",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"tipo\": \"OFERTA\",\n  \"valor\": \"80.00\",\n  \"formaPagamento\": \"PIX\",\n  \"cultoDescricao\": \"Culto Noite\"\n}"},
            "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/receitas"
          }
        },
        { "name": "GET /congregacoes/:congregacaoId/receitas?mes=...", "request": { "method": "GET", "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/receitas?mes={{mes}}" } },
        { "name": "GET /congregacoes/:congregacaoId/relatorios/financeiro?mes=...", "request": { "method": "GET", "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/relatorios/financeiro?mes={{mes}}" } },
        { "name": "GET Relatório CSV", "request": { "method": "GET", "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/relatorios/financeiro?mes={{mes}}&formato=csv" } },
        { "name": "GET Relatório PDF", "request": { "method": "GET", "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/relatorios/financeiro?mes={{mes}}&formato=pdf" } },
        { "name": "GET Relatório XLSX", "request": { "method": "GET", "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/relatorios/financeiro?mes={{mes}}&formato=xlsx" } },
        { "name": "GET Relatório DOCX", "request": { "method": "GET", "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/relatorios/financeiro?mes={{mes}}&formato=docx" } }
