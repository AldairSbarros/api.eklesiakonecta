            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"etapa\": \"MINICURSO\"\n}"},
            "url": "{{baseUrl}}/membros/{{membroId}}/etapas"
          }
        }
