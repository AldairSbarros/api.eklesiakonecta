        {
          "name": "POST /congregacoes/:congregacaoId/celulas",
          "request": {
            "method": "POST",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Célula Beta\",\n  \"geracaoId\": {{geracaoId}}\n}"},
            "url": "{{baseUrl}}/congregacoes/{{congregacaoId}}/celulas"
          }
        }
      ]
    },
    {
