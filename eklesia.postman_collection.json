          "name": "POST /congregacoes",
            "request": {
              "method": "POST",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Congregação Centro\",\n  \"igrejaId\": {{igrejaId}}\n}"},
