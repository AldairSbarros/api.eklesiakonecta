            "url": "{{baseUrl}}/celulas"
          }
        },
        { "name": "GET /celulas", "request": { "method": "GET", "url": "{{baseUrl}}/celulas" } },
        { "name": "GET /celulas/:id", "request": { "method": "GET", "url": "{{baseUrl}}/celulas/{{celulaId}}" } },
        {
          "name": "PUT /celulas/:id",
          "request": {
            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"Célula Alpha Revisada\",\n  \"horario\": \"20:00\"\n}"},
            "url": "{{baseUrl}}/celulas/{{celulaId}}"
