            "method": "PUT",
            "header": [{"key": "Content-Type", "value": "application/json"}],
            "body": {"mode": "raw", "raw": "{\n  \"nome\": \"João Silva Atualizado\",\n  \"telefone\": \"11999990000\"\n}"},
            "url": "{{baseUrl}}/membros/{{membroId}}"
          }
        },
        { "name": "DELETE /membros/:id", "request": { "method": "DELETE", "url": "{{baseUrl}}/membros/{{membroId}}" } },
        { "name": "GET /celulas/:celulaId/membros", "request": { "method": "GET", "url": "{{baseUrl}}/celulas/{{celulaId}}/membros" } },
        {
          "name": "POST /celulas/:celulaId/membros",
