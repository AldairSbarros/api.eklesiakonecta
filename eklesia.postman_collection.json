            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Congregação Zona Norte\"\n}" },
            "url": "{{baseUrl}}/igrejas/{{igrejaId}}/congregacoes"
          }
        }
      ]
    },
    {
