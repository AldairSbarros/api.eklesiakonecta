{
  "info": {
    "name": "Eklesia API Single-Tenant",
    "_postman_id": "00000000-0000-0000-0000-000000000001",
    "description": "Coleção de rotas CRUD e relatórios para a API Eklesia Single-Tenant.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000" },
    { "key": "igrejaId", "value": "1" },
    { "key": "congregacaoId", "value": "1" },
    { "key": "geracaoId", "value": "1" },
    { "key": "celulaId", "value": "1" },
    { "key": "membroId", "value": "1" },
    { "key": "mes", "value": "2025-09" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "GET /health",
          "request": { "method": "GET", "url": "{{baseUrl}}/health" }
        }
      ]
    },
    {
      "name": "Igrejas",
      "item": [
        {
          "name": "POST /igrejas",
          "request": {
            "method": "POST",
            "header": [ {"key": "Content-Type", "value": "application/json"} ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Igreja Central\"\n}" },
            "url": "{{baseUrl}}/igrejas"
          }
        },
        { "name": "GET /igrejas", "request": { "method": "GET", "url": "{{baseUrl}}/igrejas" } },
        { "name": "GET /igrejas/:id", "request": { "method": "GET", "url": "{{baseUrl}}/igrejas/{{igrejaId}}" } },
        {
          "name": "PUT /igrejas/:id",
          "request": {
            "method": "PUT",
            "header": [ {"key": "Content-Type", "value": "application/json"} ],
            "body": { "mode": "raw", "raw": "{\n  \"nome\": \"Igreja Central Revisada\"\n}" },
            "url": "{{baseUrl}}/igrejas/{{igrejaId}}"
          }
        },
        { "name": "DELETE /igrejas/:id", "request": { "method": "DELETE", "url": "{{baseUrl}}/igrejas/{{igrejaId}}" } },
