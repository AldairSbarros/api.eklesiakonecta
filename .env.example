#############################################
# Eklesia Konecta API (.env.example LIMPO)
# Copie para .env e ajuste conforme necessário
#############################################

# Banco (PostgreSQL)
DATABASE_URL=postgresql://postgres:senha@localhost:5432/eklesia?schema=public

# Ambiente
NODE_ENV=development

# Porta usada apenas quando rodando sem Docker
PORT=3000

# ==== Seed: Usuário Global ====
SEED_GLOBAL_SUPER_EMAIL=super@eklesia.app.br
SEED_GLOBAL_SUPER_PASS=TroqueEstaSenha!

# ==== Seed: Igreja padrão ====
SEED_CHURCH_NAME=Igreja Seed
SEED_CHURCH_SCHEMA=igreja_seed

# ==== Seed: Usuários do tenant ====
SEED_ADMIN_EMAIL=admin@igreja.seed
SEED_ADMIN_PASS=AdminSeed123!
SEED_SUPERUSER_EMAIL=superuser@igreja.seed
SEED_SUPERUSER_PASS=SuperSeed123!

# (Adicionar variáveis futuras aqui conforme novos módulos forem entrando)
