# ================= Ambiente Eklesia Konecta =================
# Copie para .env e ajuste valores

# Banco (PostgreSQL) - NÃO fixar schema diferente de public aqui
DATABASE_URL=postgresql://postgres:senha@postgres:5432/eklesia?schema=public

# Redis (opcional; remove se não usar)
REDIS_URL=redis://redis:6379

# Segurança / Auth
JWT_SECRET=troque_este_seguro

# Limites e Cache Prisma
PRISMA_CLIENT_CACHE_MAX=15
PRISMA_CLIENT_IDLE_TTL_MS=300000
TENANT_RATE_LIMIT=600
JSON_BODY_LIMIT=1mb

# Twilio (opcional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Node env
NODE_ENV=production
PORT=3001

# Flags de entrypoint
RUN_MIGRATIONS=true
RUN_SEED=false
